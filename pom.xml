<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>com.interview</groupId>
    <artifactId>receipt-inbox</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>receipt-inbox</name>
    <modules>
        <module>receipt-common</module>
        <module>receipt-api</module>
        <module>receipt-worker</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <azure-sdk-bom.version>1.3.8</azure-sdk-bom.version>
        <azure-monitor-opentelemetry.version>1.8.0</azure-monitor-opentelemetry.version>
        <opentelemetry-instrumentation.version>2.31.0-alpha</opentelemetry-instrumentation.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>1.65.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-monitor-opentelemetry-autoconfigure</artifactId>
                <version>${azure-monitor-opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.interview</groupId>
                <artifactId>receipt-common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>3.4.6</version>
                    <configuration>
                        <from>
                            <image>eclipse-temurin:21-jre-jammy</image>
                        </from>
                        <to>
                            <image>${env.ACR_LOGIN_SERVER}/${project.artifactId}:${env.IMAGE_TAG}</image>
                            <auth>
                                <username>00000000-0000-0000-0000-000000000000</username>
                                <password>${env.ACR_ACCESS_TOKEN}</password>
                            </auth>
                        </to>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
